    {
      "name": "model_used",
      "type": "string",
      "title": {
        "en": "Model Used"
      }
    },
    {
      "name": "best_image",
      "type": "image",
      "title": {
        "en": "Best Image"
      }
    },
    {
      "name": "best_image_camera",
      "type": "string",
      "title": {
        "en": "Best Image Camera"

{
  "title": {
    "en": "Analyze single image - structured"
  },
  "titleFormatted": {
    "en": "Analyze [[droptoken]] with structured output using [[provider]] and [[model]]: [[prompt]]"
  },
  "hint": {
    "en": "Analyze one supplied security-camera image and return structured Advanced Flow tags for people, vehicles, deliveries, packages, activity, and confidence."
  },
  "droptoken": [
    "image"
  ],
  "args": [
    {
      "type": "dropdown",
      "name": "provider",
      "title": {
        "en": "AI Provider"
      },
      "values": [
        {
          "id": "openai",
          "title": {
            "en": "OpenAI"
          }
        },
        {
          "id": "gemini",
          "title": {
            "en": "Google Gemini"
          }
        },
        {
          "id": "claude",
          "title": {
            "en": "Anthropic Claude"
          }
        },
        {
          "id": "openai_compatible",
          "title": {
            "en": "OpenAI-Compatible / Local"
          }
        }
      ]
    },
    {
      "type": "text",
      "name": "model",
      "required": false,
      "title": {
        "en": "Model"
      },
      "placeholder": {
        "en": "Optional - use provider default"
      }
    },
    {
      "type": "text",
      "name": "prompt",
      "required": false,
      "title": {
        "en": "Prompt"
      },
      "placeholder": {
        "en": "Describe the security-relevant activity visible in this image."
      }
    }
  ],
  "tokens": [
    {
      "name": "summary",
      "type": "string",
      "title": {
        "en": "Summary"
      }
    },
    {
      "name": "activity",
      "type": "string",
      "title": {
        "en": "Activity"
      }
    },
    {
      "name": "person_present",
      "type": "boolean",
      "title": {
        "en": "Person Present"
      }
    },
    {
      "name": "vehicle_present",
      "type": "boolean",
      "title": {
        "en": "Vehicle Present"
      }
    },
    {
      "name": "delivery_vehicle",
      "type": "boolean",
      "title": {
        "en": "Delivery Vehicle"
      }
    },
    {
      "name": "delivery_company",
      "type": "string",
      "title": {
        "en": "Delivery Company"
      }
    },
    {
      "name": "package_present",
      "type": "boolean",
      "title": {
        "en": "Package Present"
      }
    },
    {
      "name": "package_delivered",
      "type": "boolean",
      "title": {
        "en": "Package Delivered"
      }
    },
    {
      "name": "person_approaching",
      "type": "boolean",
      "title": {
        "en": "Person Approaching"
      }
    },
    {
      "name": "person_leaving",
      "type": "boolean",
      "title": {
        "en": "Person Leaving"
      }
    },
    {
      "name": "vehicle_arrived",
      "type": "boolean",
      "title": {
        "en": "Vehicle Arrived"
      }
    },
    {
      "name": "vehicle_departed",
      "type": "boolean",
      "title": {
        "en": "Vehicle Departed"
      }
    },
    {
      "name": "loitering",
      "type": "boolean",
      "title": {
        "en": "Loitering"
      }
    },
    {
      "name": "security_level",
      "type": "string",
      "title": {
        "en": "Security Level"
      }
    },
    {
      "name": "confidence",
      "type": "number",
      "title": {
        "en": "Confidence"
      }
    },
    {
      "name": "provider_used",
      "type": "string",
      "title": {
        "en": "Provider Used"
      }
    },
    {
      "name": "model_used",
      "type": "string",
      "title": {
        "en": "Model Used"
      }
    }
  ]
}
